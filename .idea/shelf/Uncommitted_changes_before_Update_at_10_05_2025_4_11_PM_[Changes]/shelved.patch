nt-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.level-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.exp-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.exp-progress-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 18px;\r\n}\r\n\r\n/* EXP Bar Styles */\r\n.exp-bar-background {\r\n    -fx-fill: rgba(30, 30, 30, 0.8);\r\n    -fx-stroke: #007fa7;\r\n    -fx-stroke-width: 2;\r\n    -fx-arc-width: 10;\r\n    -fx-arc-height: 10;\r\n}\r\n\r\n.exp-bar-fill {\r\n    -fx-fill: #fff943;\r\n    -fx-arc-width: 10;\r\n    -fx-arc-height: 10;\r\n}\r\n/* Checkbox Styles */\r\n.login-checkbox {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-text-fill: white;\r\n    -fx-padding: 5px;\r\n}\r\n\r\n.login-checkbox .box {\r\n    -fx-background-color: rgba(30, 30, 30, 0.8);\r\n    -fx-border-color: #18b7e7;\r\n    -fx-border-width: 1.5px;\r\n    -fx-border-radius: 3px;\r\n}\r\n\r\n.login-checkbox:selected .mark {\r\n    -fx-background-color: #18b7e7;\r\n}\r\n\r\n.login-checkbox:hover .box {\r\n    -fx-background-color: rgba(40, 40, 40, 0.8);\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 8, 0.4, 0, 0);\r\n}
