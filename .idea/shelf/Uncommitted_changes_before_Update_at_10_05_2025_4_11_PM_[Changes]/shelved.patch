<+>/* Base Styles */\r\n.app-root {\r\n    -fx-background-color: #121212;\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n}\r\n\r\n/* Overlay Container */\r\n.overlay-container {\r\n    -fx-background-color: rgba(0, 0, 0, 0.5);\r\n    -fx-alignment: center;\r\n}\r\n\r\n/* Game Over Specific Styles */\r\n.game-over-pane {\r\n    -fx-background-color: rgba(0, 0, 0, 0.7);\r\n    -fx-border-width: 1px;\r\n    -fx-border-color: #FF4040;\r\n    -fx-border-radius: 10px;\r\n    -fx-background-radius: 10px;\r\n    -fx-effect: dropshadow(gaussian, #FF4040, 15, 0.5, 0, 0);\r\n    -fx-animation: glow 3s infinite;\r\n}\r\n\r\n.game-over-box {\r\n    -fx-background-color: transparent;\r\n}\r\n\r\n.game-over-title-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 55px;\r\n    -fx-text-fill: #FF4040;\r\n    -fx-stroke: #FFFFFF;\r\n    -fx-stroke-width: 0.5;\r\n    -fx-effect: innershadow(gaussian, #FF4040, 8, 0.8, 0, 0);\r\n    -fx-alignment: center;\r\n}\r\n\r\n.game-over-stats-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 25px;\r\n    -fx-text-fill: white;\r\n    -fx-alignment: center;\r\n    -fx-wrap-text: true;\r\n}\r\n\r\n.game-over-action-button {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: semibold;\r\n    -fx-font-size: 15px;\r\n    -fx-background-color: #8B0000;\r\n    -fx-text-fill: white;\r\n    -fx-padding: 12px 25px;\r\n    -fx-background-radius: 5px;\r\n    -fx-effect: dropshadow(gaussian, #FF4040, 10, 0.5, 0, 0);\r\n    -fx-cursor: hand;\r\n}\r\n\r\n.game-over-action-button:hover {\r\n    -fx-background-color: #FF4040;\r\n    -fx-effect: dropshadow(gaussian, #FF4040, 15, 0.7, 0, 0);\r\n    -fx-scale-x: 1.05;\r\n    -fx-scale-y: 1.05;\r\n}\r\n\r\n/* Animations */\r\n@keyframes glow {\r\n    0% { -fx-effect: innershadow(gaussian, #FF4040, 6, 0.6, 0, 0); }\r\n    50% { -fx-effect: innershadow(gaussian, #FF4040, 10, 0.9, 0, 0); }\r\n    100% { -fx-effect: innershadow(gaussian, #FF4040, 6, 0.6, 0, 0); }\r\n}\r\n\r\n/* Login Specific Styles */\r\n.login-pane {\r\n    -fx-background-color: rgba(0, 0, 0, 0.7);\r\n    -fx-border-width: 1px;\r\n    -fx-border-color: #18b7e7;\r\n    -fx-border-radius: 10px;\r\n    -fx-background-radius: 10px;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 15, 0.5, 0, 0);\r\n    -fx-animation: glow 3s infinite;\r\n}\r\n\r\n.login-box {\r\n    -fx-background-color: transparent;\r\n}\r\n\r\n.login-title-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 50px;\r\n    -fx-text-fill: white;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 15, 0.7, 0, 0);\r\n    -fx-alignment: center;\r\n}\r\n\r\n.login-error-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-text-fill: #ff6363;\r\n    -fx-alignment: center;\r\n    -fx-wrap-text: true;\r\n}\r\n\r\n.login-text-field {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: semibold;\r\n    -fx-font-size: 16px;\r\n    -fx-background-color: rgba(30, 30, 30, 0.8);\r\n    -fx-text-fill: white;\r\n    -fx-padding: 12px;\r\n    -fx-border-color: #18b7e7;\r\n    -fx-border-width: 1.5px;\r\n    -fx-border-radius: 5px;\r\n    -fx-background-radius: 5px;\r\n    -fx-prompt-text-fill: #a0a0a0;\r\n}\r\n\r\n.login-text-field:focused {\r\n    -fx-border-color: #ffffff;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 10, 0.5, 0, 0);\r\n    -fx-background-color: rgba(40, 40, 40, 0.8);\r\n}\r\n\r\n.login-action-button {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: semibold;\r\n    -fx-font-size: 18px;\r\n    -fx-background-color: #177bdf;\r\n    -fx-text-fill: white;\r\n    -fx-padding: 12px 25px;\r\n    -fx-background-radius: 5px;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 10, 0.5, 0, 0);\r\n    -fx-cursor: hand;\r\n}\r\n\r\n.login-action-button:hover {\r\n    -fx-background-color: #18b7e7;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 15, 0.7, 0, 0);\r\n    -fx-scale-x: 1.05;\r\n    -fx-scale-y: 1.05;\r\n}\r\n\r\n.login-switch-button {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-background-color: transparent;\r\n    -fx-text-fill: #18b7e7;\r\n    -fx-underline: true;\r\n    -fx-cursor: hand;\r\n}\r\n\r\n.login-switch-button:hover {\r\n    -fx-text-fill: white;\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 8, 0.4, 0, 0);\r\n}\r\n\r\n/* Registration Styles */\r\n.register-pane {\r\n    -fx-background-color: rgba(0, 0, 0, 0.7);\r\n    -fx-border-width: 1px;\r\n    -fx-border-color: #ff3333;\r\n    -fx-border-radius: 10px;\r\n    -fx-background-radius: 10px;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 15, 0.5, 0, 0);\r\n    -fx-animation: glow 3s infinite;\r\n}\r\n\r\n.register-title-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 35px;\r\n    -fx-text-fill: white;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 15, 0.7, 0, 0);\r\n    -fx-alignment: center;\r\n}\r\n\r\n.register-error-label {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-text-fill: #ff6363;\r\n    -fx-alignment: center;\r\n    -fx-wrap-text: true;\r\n}\r\n\r\n.register-text-field {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: semibold;\r\n    -fx-font-size: 16px;\r\n    -fx-background-color: rgba(30, 30, 30, 0.8);\r\n    -fx-text-fill: white;\r\n    -fx-padding: 12px;\r\n    -fx-border-color: #ff3333;\r\n    -fx-border-width: 1.5px;\r\n    -fx-border-radius: 5px;\r\n    -fx-background-radius: 5px;\r\n    -fx-prompt-text-fill: #a0a0a0;\r\n}\r\n\r\n.register-text-field:focused {\r\n    -fx-border-color: #ffffff;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 10, 0.5, 0, 0);\r\n    -fx-background-color: rgba(40, 40, 40, 0.8);\r\n}\r\n\r\n.register-action-button {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: semibold;\r\n    -fx-font-size: 18px;\r\n    -fx-background-color: #e71818;\r\n    -fx-text-fill: white;\r\n    -fx-padding: 12px 25px;\r\n    -fx-background-radius: 5px;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 10, 0.5, 0, 0);\r\n    -fx-cursor: hand;\r\n}\r\n\r\n.register-action-button:hover {\r\n    -fx-background-color: #ff3333;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 15, 0.7, 0, 0);\r\n    -fx-scale-x: 1.05;\r\n    -fx-scale-y: 1.05;\r\n}\r\n\r\n.register-switch-button {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-background-color: transparent;\r\n    -fx-text-fill: #ff3333;\r\n    -fx-underline: true;\r\n    -fx-cursor: hand;\r\n}\r\n\r\n.register-switch-button:hover {\r\n    -fx-text-fill: white;\r\n    -fx-effect: dropshadow(gaussian, #ff3333, 8, 0.4, 0, 0);\r\n}\r\n\r\n.menu-box {\r\n    -fx-spacing: 20px;\r\n    -fx-alignment: center;\r\n}\r\n\r\n/* HUD Panel */\r\n.hud-panel {\r\n    -fx-background-color: rgba(0, 0, 0, 0.7);\r\n    -fx-border-color: #18b7e7;\r\n    -fx-border-width: 1;\r\n    -fx-border-radius: 5;\r\n    -fx-background-radius: 5;\r\n}\r\n\r\n/* Text Styles */\r\n.wave-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.name-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 20px;\r\n}\r\n\r\n.health-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.timer-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.level-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.exp-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: bold;\r\n    -fx-font-size: 24px;\r\n}\r\n\r\n.exp-progress-text {\r\n    -fx-font-family: 'Pixelify Sans';\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 18px;\r\n}\r\n\r\n/* EXP Bar Styles */\r\n.exp-bar-background {\r\n    -fx-fill: rgba(30, 30, 30, 0.8);\r\n    -fx-stroke: #007fa7;\r\n    -fx-stroke-width: 2;\r\n    -fx-arc-width: 10;\r\n    -fx-arc-height: 10;\r\n}\r\n\r\n.exp-bar-fill {\r\n    -fx-fill: #fff943;\r\n    -fx-arc-width: 10;\r\n    -fx-arc-height: 10;\r\n}\r\n/* Checkbox Styles */\r\n.login-checkbox {\r\n    -fx-font-family: 'Pixelify Sans', 'Verdana', sans-serif;\r\n    -fx-font-weight: medium;\r\n    -fx-font-size: 14px;\r\n    -fx-text-fill: white;\r\n    -fx-padding: 5px;\r\n}\r\n\r\n.login-checkbox .box {\r\n    -fx-background-color: rgba(30, 30, 30, 0.8);\r\n    -fx-border-color: #18b7e7;\r\n    -fx-border-width: 1.5px;\r\n    -fx-border-radius: 3px;\r\n}\r\n\r\n.login-checkbox:selected .mark {\r\n    -fx-background-color: #18b7e7;\r\n}\r\n\r\n.login-checkbox:hover .box {\r\n    -fx-background-color: rgba(40, 40, 40, 0.8);\r\n    -fx-effect: dropshadow(gaussian, #18b7e7, 8, 0.4, 0, 0);\r\n}
